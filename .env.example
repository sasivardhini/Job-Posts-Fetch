# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite by default)
# For production, consider using PostgreSQL or MySQL
# DATABASE_URL=postgresql://user:password@localhost:5432/jobdb

# Web Scraping Configuration for Major Job Boards
# LinkedIn Scraper Settings
LINKEDIN_SEARCH_KEYWORDS=software developer
LINKEDIN_LOCATION=United States

# Indeed Scraper Settings
INDEED_SEARCH_KEYWORDS=software developer
INDEED_LOCATION=United States

# Naukri Scraper Settings (India's #1 Job Portal)
NAUKRI_SEARCH_KEYWORDS=software developer
NAUKRI_LOCATION=India

# API Keys for External Job Board APIs (Optional)
# Adzuna API (get free keys at https://developer.adzuna.com/)
# ADZUNA_APP_ID=your_app_id_here
# ADZUNA_APP_KEY=your_app_key_here

# Job Fetch Configuration
AUTO_FETCH_ENABLED=false
AUTO_FETCH_INTERVAL=3600000  # 1 hour in milliseconds

# Email Configuration (for notifications - optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_password

# CORS Configuration
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Production Scraping Features
# Use Puppeteer for major job boards (LinkedIn, Indeed, Naukri) - Default: true
# Set to false to use simple HTTP requests (not recommended for production)
USE_PUPPETEER=true

# Proxy Configuration (for rotating IPs and avoiding rate limits)
# Format for residential proxies:
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=your_username  # Optional
# PROXY_PASSWORD=your_password  # Optional
#
# Popular residential proxy providers:
# - Bright Data (formerly Luminati): https://brightdata.com
# - Smartproxy: https://smartproxy.com
# - Oxylabs: https://oxylabs.io
# - GeoSurf: https://www.geosurf.com
